# ===================================================================
# HABIT TRACKER ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to habit-tracker-full/.env:
#    cp .env.example habit-tracker-full/.env
# 2. Fill in your actual secrets and configuration values.
# 3. NEVER commit .env to GitHub or any public version control!
# ===================================================================

# -------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# -------------------------------------------------------------------
# Database Storage
# -------------------------------------------------------------------
# Path to local JSON database file (used in local-first architecture)
DB_PATH=./data/db.json

# Optional: Production Database Connection String (e.g., PostgreSQL / MongoDB)
# DATABASE_URL=postgresql://user:password@localhost:5432/habittracker

# -------------------------------------------------------------------
# Authentication & Session Security
# -------------------------------------------------------------------
# Generate a secure 64-character random hex string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_key_here
SESSION_EXPIRY_HOURS=24

# -------------------------------------------------------------------
# Google Cloud & OAuth 2.0 Credentials
# -------------------------------------------------------------------
# Google Cloud Project ID
GOOGLE_PROJECT_ID=your_google_project_id

# Google Web Client ID (Public client ID used for Web browser & GIS frontend)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Google Client Secret (Private - Keep on backend only!)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Android Client ID (Used for native Android app build)
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# -------------------------------------------------------------------
# AI Habit Coach (Optional - Google AI Studio)
# -------------------------------------------------------------------
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------------
# Payment & Pro Subscriptions (Optional)
# -------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# -------------------------------------------------------------------
# Admin Dashboard
# -------------------------------------------------------------------
ADMIN_PASSWORD=secret123
